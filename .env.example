# Copy to .env and fill in. .env is gitignored and must never be committed.

# Database. DB_PASSWORD is also used by docker-compose as the container's root password,
# so changing it after the volume exists means recreating the volume:
#   docker compose down -v && docker compose up -d
DB_NAME=momentum
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/momentum
DB_USERNAME=momentum
DB_PASSWORD=change-me

# HS256 signing key. Must be at least 32 characters or the app fails to start.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated. Vite dev server by default.
CORS_ALLOWED_ORIGINS=http://localhost:5173
